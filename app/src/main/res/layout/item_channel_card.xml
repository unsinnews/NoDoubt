<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channelCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="渠道 A"
            android:textColor="#202123"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChannelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="已配置 · https://api.openai.com/v1"
            android:textColor="#6E6E80"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChannelBadge"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_button_outline"
        android:gravity="center"
        android:minWidth="62dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="已就绪"
        android:textColor="#10A37F"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/ivChannelChevron"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="Open channel"
        android:scaleType="center"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
